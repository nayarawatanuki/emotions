NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Ative somente após provisionar um banco isolado e um usuário próprio.
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=emotions_development
DB_USER=emotions_app
DB_PASSWORD=
# false apenas em loopback fora de produção; conexões remotas exigem TLS.
DB_TLS=false

# Conta separada, a provisionar após aprovação da migration. Nunca usar a conta da API.
MIGRATION_DB_USER=emotions_migrator
MIGRATION_DB_PASSWORD=

# Habilite após configurar a chave privada, origem exata e banco atualizado.
AUTH_ENABLED=false
AUTH_ORIGIN=http://127.0.0.1:3000
# 32 bytes aleatórios em hexadecimal, compartilhados entre instâncias. Nunca versionar.
AUTH_SECRET=
